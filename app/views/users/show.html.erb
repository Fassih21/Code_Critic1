<%# app/views/users/show.html.erb %>

<div class="min-h-screen bg-[#0a0a0f] font-['DM_Sans',sans-serif]">
  <%= render "shared/navbar" %>

  <main class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <%= render "shared/flash" %>

    <nav class="flex items-center gap-2 text-sm text-zinc-600 mb-8">
      <%= link_to "Projects", projects_path, class: "hover:text-zinc-400 transition-colors" %>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
      <span class="text-zinc-400">Profile</span>
    </nav>

    <div class="rounded-2xl border border-white/[0.07] bg-white/[0.03] p-8 shadow-2xl">
      <h1 class="text-white text-2xl font-semibold mb-1">Your Profile</h1>
      <p class="text-zinc-500 text-sm mb-8">Manage your account details and see your activity.</p>

      <% if @user.errors.any? %>
        <div class="mb-6 rounded-xl border border-red-500/25 bg-red-500/10 p-4">
          <div class="flex items-center gap-2 mb-2">
            <svg class="w-4 h-4 text-red-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
            </svg>
            <p class="text-red-400 text-sm font-medium">Please fix the following errors:</p>
          </div>
          <ul class="space-y-1 pl-6 list-disc">
            <% @user.errors.full_messages.each do |msg| %>
              <li class="text-red-300 text-sm"><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%# Avatar preview %>
      <div class="flex items-center gap-4 mb-8">
        <% if @user.avatar.attached? %>
          <%= image_tag @user.avatar, class: "w-16 h-16 rounded-full object-cover border border-white/10" %>
        <% else %>
          <div class="w-16 h-16 rounded-full bg-white/5 border border-white/10 flex items-center justify-center">
            <svg class="w-7 h-7 text-zinc-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
          </div>
        <% end %>
        <div>
          <p class="text-white text-sm font-medium"><%= @user.name %></p>
          <p class="text-zinc-500 text-xs"><%= @user.email %></p>
        </div>
      </div>

      <%# Stats %>
      <div class="rounded-xl border border-white/10 bg-white/[0.02] px-5 py-4 mb-8 flex items-center justify-between">
        <span class="text-zinc-400 text-sm">Projects created</span>
        <span class="text-white text-lg font-semibold"><%= @user.projects.count %></span>
      </div>

      <%= form_with model: @user, url: user_path, method: :patch, data: { turbo: true }, html: { multipart: true }, class: "space-y-5" do |f| %>

        <div class="space-y-1.5">
          <%= f.label :name, class: "block text-xs font-medium text-zinc-400 uppercase tracking-wider" %>
          <%= f.text_field :name,
                class: "w-full rounded-xl border #{@user.errors[:name].any? ? 'border-red-500/50 bg-red-500/5' : 'border-white/10 bg-white/5'}
                        text-white placeholder-zinc-600
                        py-3 px-4 text-sm
                        focus:outline-none focus:ring-2 focus:ring-violet-500/50 focus:border-violet-500/50
                        transition-all duration-200 hover:border-white/20" %>
        </div>

        <div class="space-y-1.5">
          <label class="block text-xs font-medium text-zinc-400 uppercase tracking-wider">Email</label>
          <div class="w-full rounded-xl border border-white/10 bg-white/[0.02] text-zinc-500 py-3 px-4 text-sm cursor-not-allowed">
            <%= @user.email %>
          </div>
          <p class="text-zinc-600 text-xs">Email can't be changed here.</p>
        </div>

        <div class="space-y-1.5">
          <%= f.label :avatar, "Profile picture", class: "block text-xs font-medium text-zinc-400 uppercase tracking-wider" %>
          <%= f.file_field :avatar,
                accept: "image/*",
                class: "w-full text-sm text-zinc-400
                        file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0
                        file:text-sm file:font-medium file:bg-white/10 file:text-white
                        hover:file:bg-white/20 file:cursor-pointer cursor-pointer" %>
        </div>

        <div class="flex items-center gap-3 pt-2">
          <%= f.submit "Save Changes",
                class: "px-6 py-2.5 rounded-xl text-sm font-semibold text-white
                        bg-gradient-to-r from-violet-600 to-indigo-600
                        hover:from-violet-500 hover:to-indigo-500
                        active:scale-[0.98] transition-all duration-200
                        shadow-lg shadow-violet-500/20 cursor-pointer" %>
          <%= link_to "Cancel", projects_path,
                class: "px-6 py-2.5 rounded-xl text-sm font-medium text-zinc-400
                        border border-white/10 hover:border-white/20 hover:text-white
                        transition-all duration-200" %>
        </div>

      <% end %>
    </div>
  </main>
</div>