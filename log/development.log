len(digits)==3:\r\n\r\n        hour=int(digits[0])\r\n        minute=int(digits[1:])\r\n\r\n    else:\r\n\r\n        hour=int(digits[:2])\r\n        minute=int(digits[2:])\r\n\r\n    # Validate\r\n\r\n    if hour>12:\r\n        hour%=12\r\n\r\n    if hour==0:\r\n        hour=12\r\n\r\n    if minute>59:\r\n        minute=0\r\n\r\n    time=f\"{hour}:{minute:02d}\"\r\n\r\n    times[prayer]=time\r\n\r\n    print(\"Time:\",time)\r\n\r\nprint(\"\\n====================\")\r\nprint(\"FINAL TIMINGS\")\r\nprint(times)"}, "commit"=>"Add File", "project_id"=>"9"}
